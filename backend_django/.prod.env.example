# Production environment template
# Copy to .prod.env and fill in real values

DEBUG=False
DJANGO_SETTINGS_MODULE=adare.settings.production
ALLOWED_HOSTS=adare.seclab-bonn.de
MODE=production
PYTHONUNBUFFERED=1

# Database (PostgreSQL on host)
DB_NAME=adaredb
DB_USERNAME=adare
DB_PASSWORD=CHANGE_ME
DB_HOST=localhost
DB_PORT=5432

# Celery / Redis
CELERY_BROKER=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# Gitea integration
GITEA_WEBHOOK_SECRET=CHANGE_ME
GITEA_URL=https://adare.seclab-bonn.de/git/
GITEA_API_USER=CHANGE_ME
GITEA_API_PASSWORD=CHANGE_ME

# OAuth (Gitea)
SOCIAL_AUTH_GITEA_URL=https://adare.seclab-bonn.de/git/
SOCIAL_AUTH_GITEA_INTERNAL_URL=https://adare.seclab-bonn.de/git/
SOCIAL_AUTH_GITEA_CLIENT_ID=CHANGE_ME
SOCIAL_AUTH_GITEA_SECRET=CHANGE_ME

# Frontend URL
FRONTEND_URL=https://adare.seclab-bonn.de

# Django secret key
DJANGO_SECRET_KEY=CHANGE_ME

# Server sudo password (used by deploy scripts to restart nginx etc.)
# Set this in your shell: export ADARE_SUDO=your-password
# ADARE_SUDO=CHANGE_ME

# Superuser (used by createsuperuser --noinput after DB reset)
DJANGO_SUPERUSER_USERNAME=CHANGE_ME
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME
DJANGO_SUPERUSER_EMAIL=CHANGE_ME
